# =================================
# POS Frontend Environment Variables
# =================================

# API Configuration
VITE_API_URL=/api
VITE_API_TIMEOUT=60000

# Application Configuration
VITE_APP_NAME="Restaurant POS"
VITE_APP_VERSION=1.0.0
VITE_APP_ENVIRONMENT=development

# Authentication Configuration
VITE_JWT_EXPIRY=3600
VITE_AUTO_REFRESH_TOKEN=true

# Real-time Features (Optional - for future use)
VITE_PUSHER_APP_KEY=your_pusher_app_key
VITE_PUSHER_CLUSTER=mt1
VITE_ENABLE_REALTIME=false

# File Upload Configuration
VITE_MAX_FILE_SIZE=5242880
VITE_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# Debug Configuration
VITE_DEBUG_MODE=true
VITE_LOG_LEVEL=info

# UI Configuration
VITE_DEFAULT_THEME=light
VITE_ENABLE_DARK_MODE=true
VITE_SIDEBAR_COLLAPSED=false

# Pagination Configuration
VITE_DEFAULT_PAGE_SIZE=20
VITE_MAX_PAGE_SIZE=100

# Currency Configuration
VITE_CURRENCY_SYMBOL=$
VITE_CURRENCY_CODE=USD
VITE_DECIMAL_PLACES=2

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_REPORTS=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_MULTI_TENANT=true

# Development Only (remove in production)
VITE_MOCK_API=false
VITE_SKIP_AUTH=false
