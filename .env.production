# =================================
# POS Frontend Production Environment
# =================================

# API Configuration
VITE_API_URL=https://your-api-domain.com/api
VITE_API_TIMEOUT=15000

# Application Configuration
VITE_APP_NAME="Restaurant POS"
VITE_APP_VERSION=1.0.0
VITE_APP_ENVIRONMENT=production

# Authentication Configuration
VITE_JWT_EXPIRY=7200
VITE_AUTO_REFRESH_TOKEN=true

# Real-time Features
VITE_PUSHER_APP_KEY=your_production_pusher_key
VITE_PUSHER_CLUSTER=mt1
VITE_ENABLE_REALTIME=true

# File Upload Configuration
VITE_MAX_FILE_SIZE=10485760
VITE_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# Debug Configuration
VITE_DEBUG_MODE=false
VITE_LOG_LEVEL=error

# UI Configuration
VITE_DEFAULT_THEME=light
VITE_ENABLE_DARK_MODE=true
VITE_SIDEBAR_COLLAPSED=false

# Pagination Configuration
VITE_DEFAULT_PAGE_SIZE=25
VITE_MAX_PAGE_SIZE=100

# Currency Configuration
VITE_CURRENCY_SYMBOL=$
VITE_CURRENCY_CODE=USD
VITE_DECIMAL_PLACES=2

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_REPORTS=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_MULTI_TENANT=true

# Production Configuration
VITE_MOCK_API=false
VITE_SKIP_AUTH=false